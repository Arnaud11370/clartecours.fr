---
// Landing page des campagnes « collège / brevet » (4ème, 3ème) : sans menu, non indexée pour ne pas concurrencer l'accueil.
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import Hero from "../components/sections/Hero.astro";
import Preuves from "../components/sections/Preuves.astro";
import Methode from "../components/sections/Methode.astro";
import Temoignages from "../components/sections/Temoignages.astro";
import Etapes from "../components/sections/Etapes.astro";
import Offres from "../components/sections/Offres.astro";
import QuiJeSuis from "../components/sections/QuiJeSuis.astro";
import Defi from "../components/sections/Defi.astro";
import PourQui from "../components/sections/PourQui.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";
---
<BaseLayout
  title="Cours de maths en ligne 4ème et 3ème, objectif brevet · Clarté"
  description="Votre enfant comprend en classe mais bloque seul ? Cours de maths en ligne pour la 4ème et la 3ème avec Arnaud, pour préparer le brevet. Appel diagnostic offert."
  nav={false}
>
  <meta slot="head" name="robots" content="noindex">

  <Hero
    eyebrow="Cours de maths en ligne · 4ème et 3ème · Objectif brevet"
    lead="Votre enfant comprend en classe mais bloque dès que l'exercice change ? En 4ème et en 3ème, je l'entraîne à refaire seul ce que le brevet demande vraiment."
    resultat="Angélina : 11/20 → mention TB au brevet"
  >Au brevet, il sera seul devant sa copie.</Hero>
  <Preuves />
  <Methode />
  <Temoignages />
  <Etapes />
  <Divider symbole="√" />
  <Offres />
  <QuiJeSuis />
  <Defi />
  <Divider symbole="Δ" />
  <PourQui />
  <Faq />
  <Contact />
</BaseLayout>
