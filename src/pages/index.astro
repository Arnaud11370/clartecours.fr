---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import Hero from "../components/sections/Hero.astro";
import Preuves from "../components/sections/Preuves.astro";
import Methode from "../components/sections/Methode.astro";
import Temoignages from "../components/sections/Temoignages.astro";
import Etapes from "../components/sections/Etapes.astro";
import Offres from "../components/sections/Offres.astro";
import Stages from "../components/sections/Stages.astro";
import QuiJeSuis from "../components/sections/QuiJeSuis.astro";
import Defi from "../components/sections/Defi.astro";
import PourQui from "../components/sections/PourQui.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";
---
<BaseLayout>
  <Hero
    eyebrow="Cours de maths en ligne · de la 4ème à la Première"
    lead="Je l'aide à passer de « j'ai compris quand le prof l'a fait » à « je sais le refaire tout seul, même quand l'exercice change ». Pas juste un prof. Un traducteur."
    resultat="Angélina : 11/20 → mention TB au brevet"
  >Votre enfant comprend en classe. Il <span class="strike">bloque</span> seul.</Hero>
  <Preuves />
  <Methode />
  <Temoignages />
  <Etapes />
  <Divider symbole="√" />
  <Offres />
  <Stages />
  <QuiJeSuis />
  <Defi />
  <Divider symbole="Δ" />
  <PourQui />
  <Faq />
  <Contact />
</BaseLayout>
