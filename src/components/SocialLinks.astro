---
// Rangée d'icônes des réseaux sociaux (entrées de SOCIALS avec `icons: true`), affichée dans le pied de page.
import SocialIcon from "./SocialIcon.astro";
import { SOCIALS } from "../data/site";
---
<ul class="socials" aria-label="Clarté sur les réseaux sociaux">
  {Object.values(SOCIALS).filter((s) => s.icons).map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label} (nouvel onglet)`} title={s.label}>
        <SocialIcon name={s.icon} />
      </a>
    </li>
  ))}
</ul>

<style>
  .socials{display:flex;gap:8px;margin:0;padding:0;list-style:none}
  .socials a{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;border:1px solid var(--rule);color:var(--ink-soft);transition:color .2s,border-color .2s,transform .2s}
  .socials a:hover{color:var(--gold);border-color:var(--gold);transform:translateY(-2px)}
  /* le SVG vient de SocialIcon.astro : hors du scope de ce composant, d'où :global */
  .socials a :global(svg){width:18px;height:18px}
</style>
