---
// Barre de réservation fixe en bas d'écran (cachée quand les boutons du hero ou la section de réservation sont visibles, voir scripts/site.ts)

interface Props {
  libelle?: string;
  /** Ancre de la section de réservation */
  href?: string;
  /** true : mobile seulement, compacte, masquée jusqu'à ce que le hero sorte de l'écran (landing épurée) */
  mobile?: boolean;
  /** Emplacement transmis aux événements de suivi des landing pages */
  emplacement?: string;
}
const { libelle = "Réserver mon appel offert", href = "/#contact", mobile = false, emplacement } = Astro.props;
---
<div class:list={["callbar", { mobile, away: mobile }]} id="callbar">
  <a class="btn btn-ink" href={href} data-calendly data-emplacement={emplacement}>{libelle}</a>
</div>
