---
// Bloc de réservation : agenda Calendly intégré et éléments de réassurance, sans lien qui fasse quitter la page.
import { SITE, CALENDLY_EMBED } from "../../data/site";
---
<section class="wrap" id="contact">
  <div class="contact">
    <div class="contact-head">
      <span class="eyebrow">Premier pas</span>
      <h2>Parlons de votre enfant</h2>
      <p class="lead">Choisissez un créneau pour l'appel diagnostic &amp; plan d'action, directement dans mon agenda.</p>
      <p class="contact-meta">Gratuit · 30 min en visio · sans engagement</p>
    </div>
    <div class="cal-slot">
      <div class="cal-box" id="calendly-box">
        <button class="cal-close" type="button" aria-label="Fermer l'agenda">×</button>
        <div id="calendly-embed" style="min-width:320px;height:700px;">
          <div class="cal-wait">
            <div class="cal-wait-head" aria-hidden="true"><span class="sk sk-rond"></span><span class="sk sk-ligne"></span><span class="sk sk-ligne sk-court"></span></div>
            <p class="cal-wait-txt">Chargement de mon agenda…</p>
            <div class="cal-wait-grille" aria-hidden="true">{Array.from({ length: 35 }, () => <span class="sk"></span>)}</div>
          </div>
        </div>
      </div>
    </div>
    <div class="contact-more">
      <div class="contact-arnaud">
        <img src="/img/portrait.jpg" alt="" width="64" height="64" loading="lazy">
        <p><b>C'est moi qui mène l'appel.</b> Arnaud, professeur de maths et fondateur de Clarté.</p>
      </div>
      <div class="call-steps">
        <h3>Pendant l'appel</h3>
        <ul>
          <li>On fait le point avec vous et votre enfant : ses notes, ce qui le bloque, ce qu'il a déjà essayé.</li>
          <li>Je repère ce qui est compris et ce qui est seulement « cru compris ».</li>
          <li>Vous repartez avec un plan d'action et la formule adaptée, ou une autre piste si Clarté n'est pas le bon choix.</li>
        </ul>
      </div>
      <figure class="contact-quote">
        <blockquote>« Il a obtenu la note de 12 alors qu'il pensait avant tes cours avoir 8/9. »</blockquote>
        <figcaption>Famille de Gabin · Première, spé maths</figcaption>
      </figure>
      <p class="contact-alt">Plutôt un appel ou un message ? <a href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a> · <a href={SITE.whatsapp} class="whatsapplink" target="_blank" rel="noopener">WhatsApp</a></p>
    </div>
  </div>
</section>

<script src="https://assets.calendly.com/assets/external/widget.js" is:inline></script>
<script is:inline define:vars={{ calendlyUrl: CALENDLY_EMBED }}>
  var embed = document.getElementById('calendly-embed');
  Calendly.initInlineWidget({ url: calendlyUrl, parentElement: embed, resize: true });
  // L'iframe reste masquée derrière le placeholder tant que Calendly n'a rien affiché (sinon page blanche pendant le chargement)
  function pret() { embed.setAttribute('data-pret', ''); }
  addEventListener('message', function (e) {
    if (e.origin === 'https://calendly.com' && e.data && e.data.event === 'calendly.event_type_viewed') pret();
  });
  // Filet de sécurité si Calendly ne prévient pas : on affiche peu après le chargement de l'iframe
  // (widget.js ne la crée qu'au DOMContentLoaded, juste avant ce listener-ci)
  document.addEventListener('DOMContentLoaded', function () {
    var iframe = embed.querySelector('iframe');
    if (iframe) iframe.addEventListener('load', function () { setTimeout(pret, 1500); });
  });
</script>

<script>
  /* Boutons de réservation [data-calendly] : l'agenda déjà chargé dans #contact passe en plein écran.
     On ne déplace ni ne recrée l'iframe (ça la rechargerait) : l'ouverture est donc instantanée une fois Calendly prêt. */
  const boite = document.getElementById('calendly-box');
  if (boite) {
    const place = boite.parentElement!;
    const fermer = boite.querySelector<HTMLButtonElement>('.cal-close')!;
    let retour: HTMLElement | null = null;

    const ouvrir = function () {
      place.style.height = place.offsetHeight + 'px'; // garde la place dans la page : pas de saut de mise en page derrière
      boite.classList.add('pop');
      boite.setAttribute('role', 'dialog'); boite.setAttribute('aria-modal', 'true'); boite.setAttribute('aria-label', 'Agenda de réservation');
      document.documentElement.classList.add('cal-ouvert');
      retour = document.activeElement as HTMLElement | null;
      fermer.focus();
    };
    const refermer = function () {
      boite.classList.remove('pop');
      boite.removeAttribute('role'); boite.removeAttribute('aria-modal'); boite.removeAttribute('aria-label');
      document.documentElement.classList.remove('cal-ouvert');
      place.style.height = '';
      retour?.focus();
    };

    document.addEventListener('click', function (e) {
      const lien = (e.target as Element).closest('[data-calendly]');
      if (!lien || e.ctrlKey || e.metaKey || e.shiftKey) return;
      e.preventDefault();
      ouvrir();
    });
    fermer.addEventListener('click', refermer);
    boite.addEventListener('click', function (e) { if (e.target === boite && boite.classList.contains('pop')) refermer(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && boite.classList.contains('pop')) refermer(); });
  }
</script>

<style>
  /* Agenda : emplacement dans la grille, placeholder de chargement et mode plein écran */
  .cal-slot{grid-area:cal;display:block}
  /* position + isolation : le placeholder (absolu, z-index -1) reste derrière l'iframe */
  /* min-height : Calendly annonce d'abord une hauteur de 26px avant d'afficher l'agenda, le bloc ne doit pas s'écraser */
  #calendly-embed{display:block;position:relative;isolation:isolate;min-height:700px}
  #calendly-embed :global(iframe){display:block;border-radius:10px;opacity:0;transition:opacity .4s}
  #calendly-embed[data-pret] :global(iframe){opacity:1}
  #calendly-embed :global(.calendly-spinner){display:none}
  .cal-wait{position:absolute;inset:0;z-index:-1;display:grid;align-content:start;gap:22px;padding:32px 24px;border:1px solid color-mix(in srgb,var(--on-deep) 14%,transparent);border-radius:10px}
  #calendly-embed[data-pret] .cal-wait{visibility:hidden;transition:visibility 0s .4s}
  .cal-wait-head{display:grid;justify-items:center;gap:10px}
  .sk{display:block;border-radius:6px;background:color-mix(in srgb,var(--on-deep) 12%,transparent);animation:calAttente 1.4s ease-in-out infinite}
  .sk-rond{width:56px;height:56px;border-radius:50%}
  .sk-ligne{height:12px;width:55%;max-width:240px}
  .sk-court{width:35%;max-width:150px}
  .cal-wait-txt{margin:0;text-align:center;font-family:var(--hand);font-size:1.5rem;color:color-mix(in srgb,var(--on-deep) 80%,transparent)}
  .cal-wait-grille{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;width:100%;max-width:340px;justify-self:center}
  .cal-wait-grille .sk{aspect-ratio:1;border-radius:50%}
  .cal-wait-grille .sk:nth-child(7n+3),.cal-wait-grille .sk:nth-child(5n+4){background:color-mix(in srgb,var(--p-gold) 35%,transparent)}
  @keyframes calAttente{50%{opacity:.45}}

  .cal-close{display:none}
  :global(html.cal-ouvert){overflow:hidden}
  /* La section est un contexte d'empilement (z-index:1) : on la remonte au-dessus de l'en-tête, de la barre d'appel et d'Émilie */
  :global(html.cal-ouvert) #contact > .contact{z-index:50}
  .cal-box.pop{position:fixed;inset:0;z-index:1;display:grid;place-items:center;padding:64px 24px 24px;background:color-mix(in srgb,var(--deep) 85%,transparent);backdrop-filter:blur(4px);animation:calOuvre .25s ease both}
  .cal-box.pop #calendly-embed{width:min(1000px,100%);height:min(760px,100%) !important;min-height:0;border-radius:10px;background:var(--deep)}
  .cal-box.pop .cal-close{display:grid;place-items:center;position:absolute;top:14px;right:18px;width:42px;height:42px;border-radius:50%;border:1px solid color-mix(in srgb,var(--on-deep) 30%,transparent);background:color-mix(in srgb,var(--on-deep) 10%,transparent);color:var(--on-deep);font:inherit;font-size:1.6rem;line-height:1;cursor:pointer}
  .cal-box.pop .cal-close:hover{background:color-mix(in srgb,var(--on-deep) 20%,transparent)}
  @keyframes calOuvre{from{opacity:0}}
  @media (max-width:860px){
    .cal-box.pop{padding:calc(60px + env(safe-area-inset-top,0px)) 0 env(safe-area-inset-bottom,0px)}
    .cal-box.pop #calendly-embed{height:100% !important}
    .cal-box.pop #calendly-embed :global(iframe){border-radius:10px 10px 0 0}
    .cal-box.pop .cal-close{top:calc(9px + env(safe-area-inset-top,0px))}
  }
  @media (prefers-reduced-motion:reduce){
    .sk,.cal-box.pop{animation:none}
    #calendly-embed :global(iframe){transition:none}
  }

  .contact-meta{font-size:.92rem;color:color-mix(in srgb,var(--on-deep) 75%,transparent)}
  .contact-arnaud{display:flex;align-items:center;gap:14px}
  .contact-arnaud img{width:64px;height:64px;border-radius:50%;object-fit:cover;object-position:top;border:2px solid var(--p-gold);flex:none}
  .contact-arnaud p{font-size:.95rem;color:color-mix(in srgb,var(--on-deep) 80%,transparent)}
  .contact-arnaud b{display:block;color:var(--on-deep)}
  .call-steps{display:grid;gap:10px}
  .call-steps h3{font-size:1.15rem}
  .call-steps ul{margin:0;padding:0;list-style:none;display:grid;gap:8px}
  .call-steps li{display:grid;grid-template-columns:22px 1fr;gap:6px;font-size:.95rem;color:color-mix(in srgb,var(--on-deep) 85%,transparent)}
  .call-steps li::before{content:"✓";font-weight:700;color:color-mix(in srgb,var(--p-gold) 70%,#FFFFFF)}
  .contact-quote{margin:0;padding:16px 18px;border:1px solid color-mix(in srgb,var(--on-deep) 18%,transparent);border-radius:10px;background:color-mix(in srgb,var(--on-deep) 6%,transparent);display:grid;gap:6px}
  .contact-quote blockquote{margin:0;font-family:var(--hand);font-size:1.4rem;line-height:1.25}
  .contact-quote figcaption{font-size:.85rem;color:color-mix(in srgb,var(--on-deep) 70%,transparent)}
  .contact-alt{font-size:.92rem;color:color-mix(in srgb,var(--on-deep) 75%,transparent)}
  .contact-alt a{color:var(--on-deep);font-weight:600}
</style>
