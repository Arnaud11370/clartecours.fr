---
// « Ce que je propose » : toutes les offres (formules et stages) en cartes identiques, sans tarif : les prix sont dans la FAQ.
interface Props {
  /** false : masque l'Académie (formation collège), pour les pages lycée */
  academie?: boolean;
}
const { academie = true } = Astro.props;

const cartes = [
  ...(academie ? [{
    id: "academie",
    tag: "4ème · 3ème",
    titre: "Académie Clarté Objectif Brevet",
    phrase: "La formation en ligne, avec un vrai suivi.",
    points: ["Cours en vidéo et fiches à niveaux", "Live avec moi chaque mercredi", "Plan d'action partagé avec les parents"],
  }] : []),
  {
    id: "cours",
    tag: "4ème → Première",
    titre: "Cours particuliers",
    phrase: "En individuel, sur les blocages de votre enfant.",
    points: ["En visio, avec moi", "Brevet, passage au lycée, spé maths", "Option Bachibac (maths en espagnol)"],
  },
  {
    id: "accompagnement",
    tag: "4ème → Première",
    titre: "Accompagnement sur 12 semaines",
    phrase: "Un trimestre pour viser un objectif précis.",
    points: ["Construit sur ses échéances", "Ses chapitres, son rythme", "Un plan d'action clair pour les parents"],
  },
  {
    id: "stages",
    tag: "Vacances scolaires",
    titre: "Stages de renforcement",
    phrase: "Pour combler les lacunes et repartir du bon pied.",
    points: ["En visio, avec moi", "De 1 à 4 séances d'1 h 30", "Places limitées à chaque session"],
  },
];
---
<section class="wrap" id="offres">
  <div class="sec-head">
    <svg class="doodle" viewBox="0 0 230 150" aria-hidden="true"><line x1="20" y1="130" x2="220" y2="130"/><line x1="40" y1="145" x2="40" y2="10"/><path d="M60 25 Q130 230 200 25"/><circle cx="130" cy="127" r="4"/><text x="150" y="70">f(x) = x²</text></svg>
    <span class="eyebrow">Formules et stages</span>
    <h2>Ce que je propose</h2>
    <p class="lead">{academie ? "Quatre" : "Trois"} façons de travailler ensemble, selon le besoin de votre enfant.</p>
  </div>
  <div class:list={["offers", { quatre: academie }]}>
    {cartes.map((c) => (
      <article class="offer" id={c.id}>
        <span class="tag">{c.tag}</span>
        <h3>{c.titre}</h3>
        <p class="muted">{c.phrase}</p>
        <ul>{c.points.map((p) => <li>{p}</li>)}</ul>
      </article>
    ))}
  </div>
  <div class="diag">
    <div class="badge">Offert</div>
    <div>
      <h3>Tout commence par l'appel diagnostic</h3>
      <p>30 minutes en visio, sans engagement. On choisit ensemble ce qui convient à votre enfant.</p>
    </div>
    <a class="btn btn-ink" href="#contact" data-calendly>Réserver mon appel</a>
  </div>
</section>

<script>
  /* Cartes d'offres inclinées au survol */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!reduce && window.matchMedia('(hover: hover)').matches){
    document.querySelectorAll<HTMLElement>('.offer').forEach(function(c){
      c.addEventListener('mousemove', function(e){
        const r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
        c.style.transform = 'perspective(800px) rotateY(' + (x * 6) + 'deg) rotateX(' + (-y * 6) + 'deg) translateY(-4px)';
      });
      c.addEventListener('mouseleave', function(){ c.style.transform = ''; });
    });
  }
</script>

<style>
  /* En 2×2 : sur 4 colonnes, les cartes trop étroites étirent le texte sur des lignes de 2 ou 3 mots */
  .offers.quatre{grid-template-columns:repeat(2,1fr)}
  .diag{margin:24px 0 0}
  @media (max-width:600px){.offers.quatre{grid-template-columns:1fr}}
</style>
